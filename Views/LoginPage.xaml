<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReservasBarberia.Views.LoginPage"
             Title="Iniciar sesión"
             Shell.FlyoutBehavior="Disabled"
             BackgroundColor="#1C1B19">

    <ScrollView VerticalOptions="Fill">

        <VerticalStackLayout
            Padding="28,45,28,45"
            Spacing="0"
            VerticalOptions="Center">

            
            <Border
                WidthRequest="90"
                HeightRequest="90"
                Stroke="#C9A447"
                StrokeThickness="2"
                BackgroundColor="Transparent"
                StrokeShape="Ellipse"
                HorizontalOptions="Center">

                <Label
                    Text="B"
                    FontFamily="Georgia"
                    FontSize="38"
                    FontAttributes="Bold"
                    TextColor="#C9A447"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"/>
            </Border>

            
            <Label
                Text="Reservas Barbería"
                FontFamily="Georgia"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#F7F2EB"
                HorizontalTextAlignment="Center"
                Margin="0,24,0,0"/>

            
            <Label
                Text="Inicia sesión para continuar"
                FontSize="16"
                TextColor="#C9C3BA"
                HorizontalTextAlignment="Center"
                Margin="0,12,0,0"/>

            
            <Border
                BackgroundColor="#F7F2EB"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 28"
                Padding="24"
                Margin="0,48,0,0">

                <VerticalStackLayout Spacing="0">

                    
                    <Label
                        Text="Usuario"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="#1C1B19"/>

                    <Border
                        BackgroundColor="White"
                        Stroke="#E6E0D6"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 15"
                        HeightRequest="54"
                        Padding="12,0"
                        Margin="0,10,0,4">

                        <Entry
                            Text="{Binding Usuario}"
                            Placeholder="Usuario"
                            PlaceholderColor="#888888"
                            TextColor="#1C1B19"
                            FontSize="16"
                            BackgroundColor="Transparent"
                            VerticalOptions="Center"/>
                    </Border>

                    <Label
                        Text="{Binding ErrorUsuario}"
                        TextColor="Red"
                        FontSize="13"
                        IsVisible="{Binding ErrorUsuario, Converter={StaticResource TieneTexto}}"
                        Margin="0,0,0,20"/>

                    
                    <Label
                        Text="Contraseña"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="#1C1B19"/>

                    <Border
                        BackgroundColor="White"
                        Stroke="#E6E0D6"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 15"
                        HeightRequest="54"
                        Padding="12,0"
                        Margin="0,10,0,4">

                        <Entry
                            Text="{Binding Clave}"
                            Placeholder="Contraseña"
                            PlaceholderColor="#888888"
                            TextColor="#1C1B19"
                            FontSize="16"
                            IsPassword="True"
                            BackgroundColor="Transparent"
                            VerticalOptions="Center"/>
                    </Border>

                    <Label
                        Text="{Binding ErrorClave}"
                        TextColor="Red"
                        FontSize="13"
                        IsVisible="{Binding ErrorClave, Converter={StaticResource TieneTexto}}"
                        Margin="0,0,0,20"/>

                    
                    <Button
                        Text="Iniciar sesión"
                        BackgroundColor="#C9A447"
                        TextColor="#1C1B19"
                        FontAttributes="Bold"
                        FontSize="17"
                        CornerRadius="18"
                        HeightRequest="58"
                        Margin="0,0,0,0"
                        Command="{Binding IngresarCommand}" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
