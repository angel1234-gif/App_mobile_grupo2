<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReservasBarberia.Views.LoginPage"
             Title="Iniciar sesión"
             BackgroundColor="#F5F5F5">

    <VerticalStackLayout
        Padding="30"
        Spacing="20"
        VerticalOptions="Center">

        <Label
            Text="Reservas Barbería"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label
            Text="Inicia sesión para continuar"
            FontSize="14"
            TextColor="Gray"
            HorizontalOptions="Center" />

        <Entry
            x:Name="UsuarioEntry"
            Placeholder="Usuario"
            Margin="0,20,0,0" />

        <Entry
            x:Name="ClaveEntry"
            Placeholder="Contraseña"
            IsPassword="True" />

        <Label
            x:Name="MensajeError"
            TextColor="Red"
            FontSize="14"
            HorizontalOptions="Center"
            IsVisible="False" />

        <Button
            Text="Iniciar sesión"
            BackgroundColor="#2C3E50"
            TextColor="White"
            CornerRadius="10"
            HeightRequest="50"
            Margin="0,10,0,0"
            Clicked="OnLoginClicked" />

    </VerticalStackLayout>
</ContentPage>