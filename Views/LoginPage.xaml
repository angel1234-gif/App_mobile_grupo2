<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReservasBarberia.Views.LoginPage"
             Title="Iniciar sesión"
             Shell.FlyoutBehavior="Disabled"
             BackgroundColor="#F5F5F5">

    <VerticalStackLayout
        Padding="30"
        Spacing="16"
        VerticalOptions="Center">

        <Label
            Text="Reservas Barbería"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label
            Text="Inicia sesión para continuar"
            FontSize="14"
            TextColor="Gray"
            HorizontalOptions="Center"
            Margin="0,0,0,10" />

        <!-- Usuario -->
        <VerticalStackLayout Spacing="4">
            <Entry Text="{Binding Usuario}" Placeholder="Usuario" />
            <Label
                Text="{Binding ErrorUsuario}"
                TextColor="Red"
                FontSize="13"
                IsVisible="{Binding ErrorUsuario, Converter={StaticResource TieneTexto}}" />
        </VerticalStackLayout>

        <!-- Contraseña -->
        <VerticalStackLayout Spacing="4">
            <Entry Text="{Binding Clave}" Placeholder="Contraseña" IsPassword="True" />
            <Label
                Text="{Binding ErrorClave}"
                TextColor="Red"
                FontSize="13"
                IsVisible="{Binding ErrorClave, Converter={StaticResource TieneTexto}}" />
        </VerticalStackLayout>

        <Button
            Text="Iniciar sesión"
            BackgroundColor="#2C3E50"
            TextColor="White"
            CornerRadius="10"
            HeightRequest="50"
            Margin="0,10,0,0"
            Command="{Binding IngresarCommand}" />

    </VerticalStackLayout>
</ContentPage>