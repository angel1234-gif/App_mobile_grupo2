<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ReservasBarberia.Views.LoginPage"
    Title="Iniciar sesión"
    Shell.FlyoutBehavior="Disabled"
    BackgroundColor="#101010">

    <ScrollView VerticalOptions="Fill">

        <VerticalStackLayout
            Padding="28,45,28,40"
            Spacing="0"
            VerticalOptions="Center">

            <!-- LOGO -->
            <Border
                WidthRequest="105"
                HeightRequest="105"
                Stroke="#D4AF37"
                StrokeThickness="2"
                BackgroundColor="#1B1B1B"
                StrokeShape="Ellipse"
                HorizontalOptions="Center">

                <Label
                    Text="B"
                    FontFamily="Georgia"
                    FontSize="52"
                    FontAttributes="Bold"
                    TextColor="#D4AF37"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"/>
            </Border>

            <!-- NOMBRE -->
            <Label
                Text="RESERVAS"
                FontFamily="Georgia"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#D4AF37"
                CharacterSpacing="3"
                HorizontalTextAlignment="Center"
                Margin="0,25,0,0"/>

            <Label
                Text="BARBERÍA PREMIUM"
                FontSize="13"
                CharacterSpacing="4"
                TextColor="#AAAAAA"
                HorizontalTextAlignment="Center"
                Margin="0,7,0,0"/>

            <!-- SEPARADOR -->
            <BoxView
                Color="#D4AF37"
                WidthRequest="65"
                HeightRequest="2"
                HorizontalOptions="Center"
                Margin="0,20,0,0"/>

            <Label
                Text="Bienvenido"
                FontSize="23"
                FontAttributes="Bold"
                TextColor="#FFFFFF"
                HorizontalTextAlignment="Center"
                Margin="0,25,0,0"/>

            <Label
                Text="Inicia sesión para continuar"
                FontSize="14"
                TextColor="#AAAAAA"
                HorizontalTextAlignment="Center"
                Margin="0,8,0,0"/>

            <!-- FORMULARIO -->
            <Border
                BackgroundColor="#1C1C1C"
                Stroke="#383838"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22"
                Padding="22"
                Margin="0,35,0,0">

                <VerticalStackLayout Spacing="0">

                    <!-- USUARIO -->
                    <Label
                        Text="Usuario"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#D4AF37"/>

                    <Border
                        BackgroundColor="#292929"
                        Stroke="#444444"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 13"
                        HeightRequest="55"
                        Padding="12,0"
                        Margin="0,10,0,5">

                        <Entry
                            Text="{Binding Usuario}"
                            Placeholder="Ingresa tu usuario"
                            PlaceholderColor="#888888"
                            TextColor="#FFFFFF"
                            FontSize="15"
                            BackgroundColor="Transparent"
                            VerticalOptions="Center"/>
                    </Border>

                    <Label
                        Text="{Binding ErrorUsuario}"
                        TextColor="#FF6B6B"
                        FontSize="12"
                        IsVisible="{Binding ErrorUsuario, Converter={StaticResource TieneTexto}}"
                        Margin="0,0,0,18"/>

                    <!-- CONTRASEÑA -->
                    <Label
                        Text="Contraseña"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#D4AF37"/>

                    <Border
                        BackgroundColor="#292929"
                        Stroke="#444444"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 13"
                        HeightRequest="55"
                        Padding="12,0"
                        Margin="0,10,0,5">

                        <Entry
                            Text="{Binding Clave}"
                            Placeholder="Ingresa tu contraseña"
                            PlaceholderColor="#888888"
                            TextColor="#FFFFFF"
                            FontSize="15"
                            IsPassword="True"
                            BackgroundColor="Transparent"
                            VerticalOptions="Center"/>
                    </Border>

                    <Label
                        Text="{Binding ErrorClave}"
                        TextColor="#FF6B6B"
                        FontSize="12"
                        IsVisible="{Binding ErrorClave, Converter={StaticResource TieneTexto}}"
                        Margin="0,0,0,20"/>

                    <!-- BOTÓN -->
                    <Button
                        Text="INICIAR SESIÓN"
                        BackgroundColor="#D4AF37"
                        TextColor="#101010"
                        FontAttributes="Bold"
                        FontSize="16"
                        CharacterSpacing="1"
                        CornerRadius="14"
                        HeightRequest="55"
                        Margin="0,12,0,0"
                        Command="{Binding IngresarCommand}"/>

                </VerticalStackLayout>

            </Border>

            <!-- PIE DE PÁGINA -->
            <Label
                Text="✂  ESTILO • ELEGANCIA • DISTINCIÓN"
                FontSize="11"
                CharacterSpacing="1"
                TextColor="#777777"
                HorizontalTextAlignment="Center"
                Margin="0,30,0,0"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
