<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReservasBarberia.Views.FormularioReservaPage"
             Title="Nueva Reserva"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                Text="Nueva Reserva"
                FontSize="22"
                FontAttributes="Bold" />

            <Label Text="Nombre del cliente *" FontAttributes="Bold" />
            <Entry x:Name="NombreEntry" Placeholder="Ej: Juan Pérez" />

            <Label Text="Teléfono *" FontAttributes="Bold" />
            <Entry x:Name="TelefonoEntry" Placeholder="809-000-0000" Keyboard="Telephone" />

            <Label Text="Barbero *" FontAttributes="Bold" />
            <Picker x:Name="BarberoPicker" Title="Selecciona un barbero" />

            <Label Text="Servicio *" FontAttributes="Bold" />
            <Picker x:Name="ServicioPicker" Title="Selecciona un servicio" />

            <Label Text="Fecha *" FontAttributes="Bold" />
            <DatePicker x:Name="FechaPicker" />

            <Label Text="Hora *" FontAttributes="Bold" />
            <TimePicker x:Name="HoraPicker" />

            <Label
                x:Name="MensajeError"
                TextColor="Red"
                FontSize="14"
                IsVisible="False" />

            <Button
                Text="Guardar reserva"
                BackgroundColor="#2C3E50"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="50"
                Margin="0,15,0,0"
                Clicked="OnGuardarClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>