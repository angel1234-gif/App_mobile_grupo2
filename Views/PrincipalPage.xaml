<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ReservasBarberia.Views.PrincipalPage"
    Title="Principal"
    BackgroundColor="#101010">

    <ScrollView>
        <VerticalStackLayout
            Padding="25,40,25,35"
            Spacing="0"
            VerticalOptions="Center">

            
            <Border
                WidthRequest="110"
                HeightRequest="110"
                Stroke="#D4AF37"
                StrokeThickness="2"
                BackgroundColor="#1C1C1C"
                StrokeShape="Ellipse"
                HorizontalOptions="Center">

                <Label
                    Text="B"
                    FontFamily="Georgia"
                    FontSize="55"
                    FontAttributes="Bold"
                    TextColor="#D4AF37"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"/>
            </Border>

            
            <Label
                Text="RESERVAS"
                FontFamily="Georgia"
                FontSize="29"
                FontAttributes="Bold"
                CharacterSpacing="3"
                TextColor="#D4AF37"
                HorizontalTextAlignment="Center"
                Margin="0,25,0,0"/>

            <Label
                Text="BARBERÍA PREMIUM"
                FontSize="13"
                CharacterSpacing="4"
                TextColor="#AAAAAA"
                HorizontalTextAlignment="Center"
                Margin="0,8,0,0"/>

            
            <BoxView
                Color="#D4AF37"
                WidthRequest="65"
                HeightRequest="2"
                HorizontalOptions="Center"
                Margin="0,22,0,0"/>

            
            <Label
                Text="¡Bienvenido!"
                FontSize="27"
                FontAttributes="Bold"
                TextColor="#FFFFFF"
                HorizontalTextAlignment="Center"
                Margin="0,28,0,0"/>

            <Label
                Text="¿Qué deseas hacer hoy?"
                FontSize="15"
                TextColor="#AAAAAA"
                HorizontalTextAlignment="Center"
                Margin="0,10,0,30"/>

            
            <Border
                BackgroundColor="#1C1C1C"
                Stroke="#383838"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="22">

                <VerticalStackLayout Spacing="20">

                    <!-- TITULO DEL MENU -->
                    <Label
                        Text="MENÚ PRINCIPAL"
                        FontSize="14"
                        FontAttributes="Bold"
                        CharacterSpacing="2"
                        TextColor="#D4AF37"
                        HorizontalTextAlignment="Center"
                        Margin="0,0,0,5"/>

                    <BoxView
                        Color="#383838"
                        HeightRequest="1"/>

                    
                    <Button
                        Text="✂   Ver reservas"
                        BackgroundColor="#292929"
                        TextColor="#D4AF37"
                        FontSize="17"
                        FontAttributes="Bold"
                        CornerRadius="15"
                        HeightRequest="62"
                        BorderColor="#D4AF37"
                        BorderWidth="1"
                        Command="{Binding IrAReservasCommand}"/>

                    
                    <Button
                        Text="＋   Nueva reserva"
                        BackgroundColor="#D4AF37"
                        TextColor="#101010"
                        FontSize="17"
                        FontAttributes="Bold"
                        CornerRadius="15"
                        HeightRequest="62"
                        Command="{Binding IrANuevaReservaCommand}"/>

                </VerticalStackLayout>

            </Border>

            
            <Label
                Text="Tu estilo, nuestra pasión."
                FontFamily="Georgia"
                FontSize="16"
                FontAttributes="Italic"
                TextColor="#D4AF37"
                HorizontalTextAlignment="Center"
                Margin="0,32,0,0"/>

            <Label
                Text="ESTILO  •  ELEGANCIA  •  DISTINCIÓN"
                FontSize="10"
                CharacterSpacing="2"
                TextColor="#777777"
                HorizontalTextAlignment="Center"
                Margin="0,12,0,0"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
