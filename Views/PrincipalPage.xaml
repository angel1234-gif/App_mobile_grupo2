<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReservasBarberia.Views.PrincipalPage"
             Title="Principal"
             BackgroundColor="#F7F2EB">

    <ScrollView>
        <VerticalStackLayout
            Padding="25,40,25,30"
            Spacing="0"
            VerticalOptions="Center">

            
            <Border
                WidthRequest="100"
                HeightRequest="100"
                Stroke="#C9A447"
                StrokeThickness="2"
                BackgroundColor="#1C1B19"
                StrokeShape="Ellipse"
                HorizontalOptions="Center">

                <Label
                    Text="B"
                    FontFamily="Georgia"
                    FontSize="48"
                    FontAttributes="Bold"
                    TextColor="#C9A447"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"/>
            </Border>

            
            <Label
                Text="RESERVAS BARBERÍA"
                FontFamily="Georgia"
                FontSize="25"
                FontAttributes="Bold"
                TextColor="#1C1B19"
                HorizontalTextAlignment="Center"
                Margin="0,25,0,0"/>

            
            <Label
                Text="Bienvenido"
                FontSize="23"
                FontAttributes="Bold"
                TextColor="#1C1B19"
                HorizontalTextAlignment="Center"
                Margin="0,30,0,0"/>

            <Label
                Text="¿Qué deseas hacer hoy?"
                FontSize="16"
                TextColor="#888078"
                HorizontalTextAlignment="Center"
                Margin="0,8,0,30"/>

            
            <Border
                BackgroundColor="White"
                Stroke="#E6E0D6"
                StrokeThickness="1.5"
                StrokeShape="RoundRectangle 28"
                Padding="22">

                <VerticalStackLayout Spacing="18">

                    
                    <Label
                        Text="MENÚ PRINCIPAL"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#A18A57"
                        HorizontalTextAlignment="Center"
                        Margin="0,0,0,5"/>

                    
                    <Button
                        Text="Ver reservas"
                        BackgroundColor="#1C1B19"
                        TextColor="#F7F2EB"
                        FontSize="17"
                        FontAttributes="Bold"
                        CornerRadius="18"
                        HeightRequest="62"
                        Command="{Binding IrAReservasCommand}"/>

                    
                    <Button
                        Text="Nueva reserva"
                        BackgroundColor="#C9A447"
                        TextColor="#1C1B19"
                        FontSize="17"
                        FontAttributes="Bold"
                        CornerRadius="18"
                        HeightRequest="62"
                        Command="{Binding IrANuevaReservaCommand}"/>

                </VerticalStackLayout>

            </Border>

            
            <Label
                Text="Tu estilo, nuestra pasión."
                FontFamily="Georgia"
                FontSize="15"
                FontAttributes="Italic"
                TextColor="#888078"
                HorizontalTextAlignment="Center"
                Margin="0,30,0,0"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
