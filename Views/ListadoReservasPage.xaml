<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:ReservasBarberia.Models"
    xmlns:vm="clr-namespace:ReservasBarberia.ViewModels"
    x:Class="ReservasBarberia.Views.ListadoReservasPage"
    Title="Mis Reservas"
    BackgroundColor="#101010">

    <Grid
        RowDefinitions="Auto,*"
        Padding="22,30,22,20"
        RowSpacing="22">


        <VerticalStackLayout
            Grid.Row="0"
            Spacing="8">

            <Label
                Text="GESTIÓN DE CITAS"
                FontSize="12"
                CharacterSpacing="3"
                FontAttributes="Bold"
                TextColor="#D4AF37"/>

            <Label
                Text="Mis Reservas"
                FontFamily="Georgia"
                FontSize="29"
                FontAttributes="Bold"
                TextColor="#FFFFFF"/>

            <Label
                Text="Consulta las reservas de tus clientes"
                FontSize="14"
                TextColor="#AAAAAA"/>

            <BoxView
                Color="#D4AF37"
                HeightRequest="2"
                WidthRequest="55"
                HorizontalOptions="Start"
                Margin="0,8,0,0"/>

        </VerticalStackLayout>


        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Reservas}"
            SelectionMode="None">


            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Spacing="15"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Padding="25">

                    <Label
                        Text="✂"
                        FontSize="55"
                        TextColor="#D4AF37"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="No hay reservas todavía"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="#FFFFFF"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="Cuando registres una nueva cita, aparecerá aquí."
                        FontSize="13"
                        TextColor="#AAAAAA"
                        HorizontalTextAlignment="Center"/>

                </VerticalStackLayout>

            </CollectionView.EmptyView>


            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Stroke="#383838"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="#1C1C1C"
                        Padding="17"
                        Margin="0,0,0,14">

                        
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ReservaViewModel}}, Path=EditarCommand}"
                                CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="14">

                            
                            <Grid
                                ColumnDefinitions="65,*,Auto"
                                ColumnSpacing="13">

                                <Border
                                    Grid.Column="0"
                                    WidthRequest="58"
                                    HeightRequest="58"
                                    BackgroundColor="#292929"
                                    Stroke="#D4AF37"
                                    StrokeThickness="1.5"
                                    StrokeShape="Ellipse"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="✂"
                                        FontSize="25"
                                        TextColor="#D4AF37"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"/>

                                </Border>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="5"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding ClienteNombre}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="#FFFFFF"/>

                                    <Label
                                        Text="{Binding ClienteTelefono}"
                                        FontSize="13"
                                        TextColor="#AAAAAA"/>

                                </VerticalStackLayout>

                                
                                <Button
                                    Grid.Column="2"
                                    Text="Eliminar"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    Padding="12,0"
                                    HeightRequest="34"
                                    VerticalOptions="Start"
                                    BackgroundColor="Transparent"
                                    TextColor="#FF6B6B"
                                    BorderColor="#FF6B6B"
                                    BorderWidth="1"
                                    CornerRadius="10"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ReservaViewModel}}, Path=EliminarDeListaCommand}"
                                    CommandParameter="{Binding .}"/>

                            </Grid>

                            <BoxView
                                Color="#383838"
                                HeightRequest="1"/>


                            <VerticalStackLayout Spacing="10">

                                <Grid ColumnDefinitions="28,*">

                                    <Label
                                        Text="✂"
                                        FontSize="16"
                                        TextColor="#D4AF37"/>

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Barbero, StringFormat='Barbero: {0}'}"
                                        FontSize="14"
                                        TextColor="#EEEEEE"
                                        VerticalOptions="Center"/>

                                </Grid>

                                <Grid ColumnDefinitions="28,*">

                                    <Label
                                        Text="◆"
                                        FontSize="15"
                                        TextColor="#D4AF37"/>

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Servicio, StringFormat='Servicio: {0}'}"
                                        FontSize="14"
                                        TextColor="#EEEEEE"
                                        VerticalOptions="Center"/>

                                </Grid>

                            </VerticalStackLayout>


                            <Border
                                BackgroundColor="#302A1B"
                                Stroke="#8D712B"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 13"
                                Padding="13">

                                <Grid ColumnDefinitions="Auto,*">

                                    <Label
                                        Text="◷"
                                        FontSize="22"
                                        TextColor="#D4AF37"
                                        VerticalOptions="Center"/>

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding FechaHoraTexto}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="#E8C86A"
                                        VerticalOptions="Center"
                                        Margin="10,0,0,0"/>

                                </Grid>

                            </Border>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>