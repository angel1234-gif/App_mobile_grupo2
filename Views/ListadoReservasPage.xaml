<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ReservasBarberia.Models"
             x:Class="ReservasBarberia.Views.ListadoReservasPage"
             Title="Mis Reservas"
             BackgroundColor="#F7F2EB">

    <Grid RowDefinitions="Auto,*"
          Padding="24,30,24,20"
          RowSpacing="25">

        
        <Label
            Grid.Row="0"
            Text="Reservas registradas"
            FontFamily="Georgia"
            FontSize="29"
            FontAttributes="Bold"
            TextColor="#1C1B19"
            VerticalOptions="Center"/>

        
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Reservas}">

            <CollectionView.EmptyView>
                <Label
                    Text="Todavía no hay reservas. Crea una desde 'Nueva Reserva'."
                    TextColor="Gray"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Reserva">

                    
                    <Border
                        Stroke="#E6E0D6"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 25"
                        BackgroundColor="White"
                        Padding="18"
                        Margin="0,0,0,12">

                        <Grid ColumnDefinitions="85,*"
                              ColumnSpacing="15">

                            
                            <Border
                                Grid.Column="0"
                                WidthRequest="70"
                                HeightRequest="70"
                                BackgroundColor="#1C1B19"
                                Stroke="Transparent"
                                StrokeShape="Ellipse"
                                VerticalOptions="Start">

                                <Label
                                    Text="✂"
                                    FontSize="27"
                                    TextColor="#C9A447"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"/>
                            </Border>

                            
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="8">

                                <Label
                                    Text="{Binding ClienteNombre}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="#1C1B19"/>

                                <Label
                                    Text="{Binding ClienteTelefono}"
                                    FontSize="16"
                                    TextColor="#888888"/>

                                <Label
                                    Text="{Binding Barbero, StringFormat='Barbero: {0}'}"
                                    FontSize="16"
                                    TextColor="#292929"/>

                                <Label
                                    Text="{Binding Servicio, StringFormat='Servicio: {0}'}"
                                    FontSize="16"
                                    TextColor="#292929"/>

                                
                                <Border
                                    BackgroundColor="#F2E8CC"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 18"
                                    Padding="12,8"
                                    HorizontalOptions="Start"
                                    Margin="0,8,0,0">

                                    <Label
                                        Text="{Binding FechaHoraTexto}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="#79591F"/>

                                </Border>

                            </VerticalStackLayout>

                        </Grid>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>
