<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ReservasBarberia.Models"
             x:Class="ReservasBarberia.Views.ListadoReservasPage"
             Title="Mis Reservas"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*" Padding="20" RowSpacing="15">

        <Label
            Grid.Row="0"
            Text="Reservas registradas"
            FontSize="22"
            FontAttributes="Bold" />

        <CollectionView x:Name="ReservasCollection" Grid.Row="1">

            <CollectionView.EmptyView>
                <Label
                    Text="Todavía no hay reservas. Crea una desde 'Nueva Reserva'."
                    TextColor="Gray"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Reserva">
                    <Border
                        Stroke="#DDDDDD"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="White"
                        Padding="15"
                        Margin="0,6">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding ClienteNombre}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding ClienteTelefono}" TextColor="Gray" />
                            <Label Text="{Binding Barbero, StringFormat='Barbero: {0}'}" />
                            <Label Text="{Binding Servicio, StringFormat='Servicio: {0}'}" />
                            <Label Text="{Binding FechaHoraTexto}" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>
</ContentPage>