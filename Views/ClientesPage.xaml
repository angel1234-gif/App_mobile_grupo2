<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:ReservasBarberia.Models"
    x:Class="ReservasBarberia.Views.ClientesPage"
    Title="Clientes"
    BackgroundColor="#101010">

    <ScrollView>
        <VerticalStackLayout
            Padding="22,28,22,30"
            Spacing="20">

            
            <VerticalStackLayout Spacing="7">

                <Label
                    Text="GESTIÓN DE CLIENTES"
                    FontSize="12"
                    CharacterSpacing="2"
                    FontAttributes="Bold"
                    TextColor="#D4AF37"/>

                <Label
                    Text="Nuestros Clientes"
                    FontFamily="Georgia"
                    FontSize="29"
                    FontAttributes="Bold"
                    TextColor="#FFFFFF"/>

                <Label
                    Text="Registra y administra la información de tus clientes."
                    FontSize="14"
                    TextColor="#AAAAAA"/>

                <BoxView
                    Color="#D4AF37"
                    HeightRequest="2"
                    WidthRequest="55"
                    HorizontalOptions="Start"
                    Margin="0,8,0,0"/>

            </VerticalStackLayout>

            
            <Border
                BackgroundColor="#1C1C1C"
                Stroke="#383838"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22"
                Padding="20">

                <VerticalStackLayout Spacing="17">

                    <Label
                        Text="REGISTRAR NUEVO CLIENTE"
                        FontSize="13"
                        CharacterSpacing="1.5"
                        FontAttributes="Bold"
                        TextColor="#D4AF37"/>

                    <BoxView
                        Color="#383838"
                        HeightRequest="1"/>

                    
                    <VerticalStackLayout Spacing="7">

                        <Label
                            Text="Nombre completo *"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#FFFFFF"/>

                        <Border
                            BackgroundColor="#292929"
                            Stroke="#444444"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 13"
                            HeightRequest="55"
                            Padding="12,0">

                            <Entry
                                Text="{Binding Nombre}"
                                Placeholder="Ej: Juan Pérez"
                                PlaceholderColor="#888888"
                                TextColor="#FFFFFF"
                                FontSize="15"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center"/>

                        </Border>

                        <Label
                            Text="{Binding ErrorNombre}"
                            TextColor="#FF6B6B"
                            FontSize="12"
                            IsVisible="{Binding ErrorNombre, Converter={StaticResource TieneTexto}}"/>

                    </VerticalStackLayout>

                    
                    <VerticalStackLayout Spacing="7">

                        <Label
                            Text="Teléfono *"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#FFFFFF"/>

                        <Border
                            BackgroundColor="#292929"
                            Stroke="#444444"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 13"
                            HeightRequest="55"
                            Padding="12,0">

                            <Entry
                                Text="{Binding Telefono}"
                                Placeholder="809-000-0000"
                                PlaceholderColor="#888888"
                                TextColor="#FFFFFF"
                                FontSize="15"
                                Keyboard="Telephone"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center"/>

                        </Border>

                        <Label
                            Text="{Binding ErrorTelefono}"
                            TextColor="#FF6B6B"
                            FontSize="12"
                            IsVisible="{Binding ErrorTelefono, Converter={StaticResource TieneTexto}}"/>

                    </VerticalStackLayout>

                    
                    <VerticalStackLayout Spacing="7">

                        <Label
                            Text="Correo electrónico *"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#FFFFFF"/>

                        <Border
                            BackgroundColor="#292929"
                            Stroke="#444444"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 13"
                            HeightRequest="55"
                            Padding="12,0">

                            <Entry
                                Text="{Binding Correo}"
                                Placeholder="Ej: juan@correo.com"
                                PlaceholderColor="#888888"
                                TextColor="#FFFFFF"
                                FontSize="15"
                                Keyboard="Email"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center"/>

                        </Border>

                        <Label
                            Text="{Binding ErrorCorreo}"
                            TextColor="#FF6B6B"
                            FontSize="12"
                            IsVisible="{Binding ErrorCorreo, Converter={StaticResource TieneTexto}}"/>

                    </VerticalStackLayout>

                    
                    <Button
                        Text="＋   GUARDAR CLIENTE"
                        BackgroundColor="#D4AF37"
                        TextColor="#101010"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="14"
                        HeightRequest="58"
                        Margin="0,8,0,0"
                        Command="{Binding GuardarCommand}"/>

                </VerticalStackLayout>

            </Border>

            
            <VerticalStackLayout Spacing="7">

                <Label
                    Text="DIRECTORIO"
                    FontSize="12"
                    CharacterSpacing="2"
                    FontAttributes="Bold"
                    TextColor="#D4AF37"/>

                <Label
                    Text="Clientes registrados"
                    FontFamily="Georgia"
                    FontSize="25"
                    FontAttributes="Bold"
                    TextColor="#FFFFFF"/>

                <Label
                    Text="Información de contacto de tus clientes."
                    FontSize="13"
                    TextColor="#AAAAAA"/>

            </VerticalStackLayout>

            
            <VerticalStackLayout
                Spacing="14"
                BindableLayout.ItemsSource="{Binding Clientes}">

                
                <BindableLayout.EmptyView>

                    <Border
                        BackgroundColor="#1C1C1C"
                        Stroke="#383838"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="22">

                        <VerticalStackLayout
                            Spacing="10"
                            HorizontalOptions="Center">

                            <Label
                                Text="♙"
                                FontSize="42"
                                TextColor="#D4AF37"
                                HorizontalTextAlignment="Center"/>

                            <Label
                                Text="No hay clientes registrados"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#FFFFFF"
                                HorizontalTextAlignment="Center"/>

                            <Label
                                Text="Registra tu primer cliente utilizando el formulario."
                                FontSize="13"
                                TextColor="#AAAAAA"
                                HorizontalTextAlignment="Center"/>

                        </VerticalStackLayout>

                    </Border>

                </BindableLayout.EmptyView>

                <BindableLayout.ItemTemplate>

                    <DataTemplate x:DataType="models:Cliente">

                        <Border
                            BackgroundColor="#1C1C1C"
                            Stroke="#383838"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="17">

                            <Grid
                                ColumnDefinitions="75,*"
                                ColumnSpacing="14">

                                
                                <Border
                                    Grid.Column="0"
                                    WidthRequest="65"
                                    HeightRequest="65"
                                    BackgroundColor="#292929"
                                    Stroke="#D4AF37"
                                    StrokeThickness="1.5"
                                    StrokeShape="Ellipse"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding Nombre, Converter={StaticResource InicialConverter}}"
                                        FontFamily="Georgia"
                                        FontSize="28"
                                        FontAttributes="Bold"
                                        TextColor="#D4AF37"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"/>

                                </Border>

                                
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="8"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding Nombre}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="#FFFFFF"/>

                                    <Grid ColumnDefinitions="22,*">

                                        <Label
                                            Text="☎"
                                            FontSize="14"
                                            TextColor="#D4AF37"/>

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Telefono}"
                                            FontSize="13"
                                            TextColor="#DDDDDD"
                                            VerticalOptions="Center"/>

                                    </Grid>

                                    <Grid ColumnDefinitions="22,*">

                                        <Label
                                            Text="✉"
                                            FontSize="14"
                                            TextColor="#D4AF37"/>

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Correo}"
                                            FontSize="12"
                                            TextColor="#AAAAAA"
                                            VerticalOptions="Center"/>

                                    </Grid>

                                </VerticalStackLayout>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </BindableLayout.ItemTemplate>

            </VerticalStackLayout>

            
            <Label
                Text="✂  CADA CLIENTE ES ESPECIAL"
                FontSize="10"
                CharacterSpacing="1.5"
                TextColor="#777777"
                HorizontalTextAlignment="Center"
                Margin="0,8,0,0"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
