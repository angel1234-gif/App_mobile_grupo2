<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ReservasBarberia.Views.EstadisticasPage"
    Title="Estadísticas"
    BackgroundColor="#101010">

    <ScrollView>
        <VerticalStackLayout
            Padding="22,30,22,30"
            Spacing="22">

            
            <VerticalStackLayout Spacing="8">

                <Label
                    Text="RESUMEN DEL NEGOCIO"
                    FontSize="12"
                    CharacterSpacing="3"
                    FontAttributes="Bold"
                    TextColor="#D4AF37"/>

                <Label
                    Text="Estadísticas"
                    FontFamily="Georgia"
                    FontSize="29"
                    FontAttributes="Bold"
                    TextColor="#FFFFFF"/>

                <Label
                    Text="Así va tu barbería según las reservas registradas"
                    FontSize="14"
                    TextColor="#AAAAAA"/>

                <BoxView
                    Color="#D4AF37"
                    HeightRequest="2"
                    WidthRequest="55"
                    HorizontalOptions="Start"
                    Margin="0,8,0,0"/>

            </VerticalStackLayout>


            
            <Border
                IsVisible="{Binding SinDatos}"
                BackgroundColor="#1C1C1C"
                Stroke="#383838"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="24">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="📊"
                        FontSize="45"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="Aún no hay reservas para analizar"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="#FFFFFF"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="Registra algunas citas y aquí verás tus números."
                        FontSize="13"
                        TextColor="#AAAAAA"
                        HorizontalTextAlignment="Center"/>

                </VerticalStackLayout>

            </Border>


            
            <VerticalStackLayout
                IsVisible="{Binding HayDatos}"
                Spacing="22">

                
                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="14">

                    <Border
                        Grid.Column="0"
                        BackgroundColor="#1C1C1C"
                        Stroke="#383838"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="16">

                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="{Binding TotalReservas}"
                                FontSize="32"
                                FontAttributes="Bold"
                                TextColor="#D4AF37"/>
                            <Label
                                Text="Reservas totales"
                                FontSize="13"
                                TextColor="#AAAAAA"/>
                        </VerticalStackLayout>

                    </Border>

                    <Border
                        Grid.Column="1"
                        BackgroundColor="#1C1C1C"
                        Stroke="#383838"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="16">

                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="{Binding ReservasHoy}"
                                FontSize="32"
                                FontAttributes="Bold"
                                TextColor="#D4AF37"/>
                            <Label
                                Text="Reservas de hoy"
                                FontSize="13"
                                TextColor="#AAAAAA"/>
                        </VerticalStackLayout>

                    </Border>

                </Grid>

                <Border
                    BackgroundColor="#302A1B"
                    Stroke="#8D712B"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="18">

                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="{Binding IngresoEstimado}"
                            FontSize="30"
                            FontAttributes="Bold"
                            TextColor="#E8C86A"/>
                        <Label
                            Text="Ingreso estimado por servicios reservados"
                            FontSize="13"
                            TextColor="#AAAAAA"/>
                    </VerticalStackLayout>

                </Border>


                
                <Border
                    BackgroundColor="#1C1C1C"
                    Stroke="#383838"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Padding="18">

                    <VerticalStackLayout Spacing="16">

                        <Label
                            Text="SERVICIOS MÁS PEDIDOS"
                            FontSize="13"
                            CharacterSpacing="1.5"
                            FontAttributes="Bold"
                            TextColor="#D4AF37"/>

                        <VerticalStackLayout
                            Spacing="14"
                            BindableLayout.ItemsSource="{Binding ServiciosPopulares}">

                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="6">

                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label
                                                Text="{Binding Nombre}"
                                                FontSize="14"
                                                TextColor="#FFFFFF"/>
                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding Total, StringFormat='{0} reservas'}"
                                                FontSize="13"
                                                FontAttributes="Bold"
                                                TextColor="#E8C86A"/>
                                        </Grid>

                                        <ProgressBar
                                            Progress="{Binding Proporcion}"
                                            ProgressColor="#D4AF37"/>

                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>


                
                <Border
                    BackgroundColor="#1C1C1C"
                    Stroke="#383838"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Padding="18">

                    <VerticalStackLayout Spacing="16">

                        <Label
                            Text="RESERVAS POR BARBERO"
                            FontSize="13"
                            CharacterSpacing="1.5"
                            FontAttributes="Bold"
                            TextColor="#D4AF37"/>

                        <VerticalStackLayout
                            Spacing="14"
                            BindableLayout.ItemsSource="{Binding ReservasPorBarbero}">

                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="6">

                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label
                                                Text="{Binding Nombre}"
                                                FontSize="14"
                                                TextColor="#FFFFFF"/>
                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding Total, StringFormat='{0} reservas'}"
                                                FontSize="13"
                                                FontAttributes="Bold"
                                                TextColor="#E8C86A"/>
                                        </Grid>

                                        <ProgressBar
                                            Progress="{Binding Proporcion}"
                                            ProgressColor="#D4AF37"/>

                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>