<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:ReservasBarberia.Models"
    xmlns:vm="clr-namespace:ReservasBarberia.ViewModels"
    xmlns:converters="clr-namespace:ReservasBarberia.Converters"
    x:Class="ReservasBarberia.Views.BarberosPage"
    Title="Barberos"
    BackgroundColor="#101010">


    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InicialConverter
                x:Key="InicialConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView x:Name="Desplazador">
        <VerticalStackLayout
            Padding="22,28,22,30"
            Spacing="20">


            <VerticalStackLayout Spacing="7">

                <Label
                    Text="PERSONAL DE LA BARBERÍA"
                    FontSize="12"
                    CharacterSpacing="2"
                    FontAttributes="Bold"
                    TextColor="#D4AF37"/>

                <Label
                    Text="Barberos"
                    FontFamily="Georgia"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="#FFFFFF"/>

                <Label
                    Text="Administra tu equipo de profesionales."
                    FontSize="14"
                    TextColor="#AAAAAA"/>

                <BoxView
                    Color="#D4AF37"
                    HeightRequest="2"
                    WidthRequest="55"
                    HorizontalOptions="Start"
                    Margin="0,8,0,0"/>

            </VerticalStackLayout>


            <Border
                BackgroundColor="#1C1C1C"
                Stroke="#383838"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22"
                Padding="20">

                <VerticalStackLayout Spacing="17">

                    <Label
                        Text="{Binding Titulo}"
                        TextTransform="Uppercase"
                        FontSize="13"
                        CharacterSpacing="1.5"
                        FontAttributes="Bold"
                        TextColor="#D4AF37"/>

                    <BoxView
                        Color="#383838"
                        HeightRequest="1"/>


                    <VerticalStackLayout Spacing="7">

                        <Label
                            Text="Nombre completo"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#FFFFFF"/>

                        <Border
                            BackgroundColor="#292929"
                            Stroke="#444444"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 13"
                            HeightRequest="55"
                            Padding="12,0">

                            <Entry
                                Text="{Binding Nombre}"
                                Placeholder="Ej: Junior Pérez"
                                PlaceholderColor="#888888"
                                TextColor="#FFFFFF"
                                FontSize="15"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center"/>

                        </Border>

                        <Label
                            Text="{Binding ErrorNombre}"
                            TextColor="#FF6B6B"
                            FontSize="12"
                            IsVisible="{Binding ErrorNombre, Converter={StaticResource TieneTexto}}"/>

                    </VerticalStackLayout>


                    <VerticalStackLayout Spacing="7">

                        <Label
                            Text="Especialidad"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#FFFFFF"/>

                        <Border
                            BackgroundColor="#292929"
                            Stroke="#444444"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 13"
                            HeightRequest="55"
                            Padding="12,0">

                            <Entry
                                Text="{Binding Especialidad}"
                                Placeholder="Ej: Fade y diseño"
                                PlaceholderColor="#888888"
                                TextColor="#FFFFFF"
                                FontSize="15"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center"/>

                        </Border>

                        <Label
                            Text="{Binding ErrorEspecialidad}"
                            TextColor="#FF6B6B"
                            FontSize="12"
                            IsVisible="{Binding ErrorEspecialidad, Converter={StaticResource TieneTexto}}"/>

                    </VerticalStackLayout>


                    <VerticalStackLayout Spacing="7">

                        <Label
                            Text="Teléfono"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#FFFFFF"/>

                        <Border
                            BackgroundColor="#292929"
                            Stroke="#444444"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 13"
                            HeightRequest="55"
                            Padding="12,0">

                            <Entry
                                Text="{Binding Telefono}"
                                Placeholder="809-000-0000"
                                PlaceholderColor="#888888"
                                TextColor="#FFFFFF"
                                FontSize="15"
                                Keyboard="Telephone"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center"/>

                        </Border>

                        <Label
                            Text="{Binding ErrorTelefono}"
                            TextColor="#FF6B6B"
                            FontSize="12"
                            IsVisible="{Binding ErrorTelefono, Converter={StaticResource TieneTexto}}"/>

                    </VerticalStackLayout>


                    <Button
                        Text="{Binding TextoBotonGuardar, StringFormat='＋   {0}'}"
                        TextTransform="Uppercase"
                        BackgroundColor="#D4AF37"
                        TextColor="#101010"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="14"
                        HeightRequest="56"
                        Margin="0,8,0,0"
                        Command="{Binding GuardarCommand}"/>

                    <!-- NUEVO: solo se ven en modo edición -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding EsEdicion}">

                        <Button
                            Text="ELIMINAR BARBERO"
                            BackgroundColor="Transparent"
                            TextColor="#FF6B6B"
                            BorderColor="#FF6B6B"
                            BorderWidth="1"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="14"
                            HeightRequest="54"
                            Command="{Binding EliminarActualCommand}"/>

                        <Button
                            Text="CANCELAR"
                            BackgroundColor="Transparent"
                            TextColor="#AAAAAA"
                            BorderColor="#444444"
                            BorderWidth="1"
                            FontSize="15"
                            CornerRadius="14"
                            HeightRequest="54"
                            Command="{Binding CancelarEdicionCommand}"/>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>


            <VerticalStackLayout Spacing="7">

                <Label
                    Text="NUESTRO EQUIPO"
                    FontSize="12"
                    CharacterSpacing="2"
                    FontAttributes="Bold"
                    TextColor="#D4AF37"/>

                <Label
                    Text="Barberos registrados"
                    FontFamily="Georgia"
                    FontSize="25"
                    FontAttributes="Bold"
                    TextColor="#FFFFFF"/>

                <Label
                    Text="Profesionales que forman parte de nuestro equipo."
                    FontSize="13"
                    TextColor="#AAAAAA"/>

            </VerticalStackLayout>


            <VerticalStackLayout
                Spacing="13"
                BindableLayout.ItemsSource="{Binding Barberos}">


                <BindableLayout.EmptyView>

                    <Border
                        BackgroundColor="#1C1C1C"
                        Stroke="#383838"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="22">

                        <VerticalStackLayout
                            Spacing="10"
                            HorizontalOptions="Center">

                            <Label
                                Text="✂"
                                FontSize="40"
                                TextColor="#D4AF37"
                                HorizontalTextAlignment="Center"/>

                            <Label
                                Text="Todavía no hay barberos"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#FFFFFF"
                                HorizontalTextAlignment="Center"/>

                            <Label
                                Text="Registra tu primer profesional."
                                FontSize="13"
                                TextColor="#AAAAAA"
                                HorizontalTextAlignment="Center"/>

                        </VerticalStackLayout>

                    </Border>

                </BindableLayout.EmptyView>

                <BindableLayout.ItemTemplate>

                    <DataTemplate>

                        <Border
                            BackgroundColor="#1C1C1C"
                            Stroke="#383838"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 19"
                            Padding="17">

                            <!-- NUEVO: tocar la tarjeta carga el barbero en el formulario -->
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BarberoViewModel}}, Path=EditarCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>

                            <Grid
                                ColumnDefinitions="75,*,Auto"
                                ColumnSpacing="14">


                                <Border
                                    Grid.Column="0"
                                    WidthRequest="65"
                                    HeightRequest="65"
                                    BackgroundColor="#292929"
                                    Stroke="#D4AF37"
                                    StrokeThickness="1.5"
                                    StrokeShape="Ellipse"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding Nombre, Converter={StaticResource InicialConverter}}"
                                        FontFamily="Georgia"
                                        FontSize="28"
                                        FontAttributes="Bold"
                                        TextColor="#D4AF37"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"/>

                                </Border>


                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="7"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding Nombre}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="#FFFFFF"/>

                                    <Label
                                        Text="{Binding Especialidad}"
                                        FontSize="14"
                                        TextColor="#D4AF37"/>

                                    <Label
                                        Text="{Binding Telefono}"
                                        FontSize="13"
                                        TextColor="#AAAAAA"/>

                                </VerticalStackLayout>

                                <!-- NUEVO: botón pequeño para eliminar directamente desde la lista -->
                                <Button
                                    Grid.Column="2"
                                    Text="Eliminar"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    Padding="12,0"
                                    HeightRequest="34"
                                    VerticalOptions="Start"
                                    BackgroundColor="Transparent"
                                    TextColor="#FF6B6B"
                                    BorderColor="#FF6B6B"
                                    BorderWidth="1"
                                    CornerRadius="10"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BarberoViewModel}}, Path=EliminarDeListaCommand}"
                                    CommandParameter="{Binding .}"/>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </BindableLayout.ItemTemplate>

            </VerticalStackLayout>


            <Label
                Text="✂  TALENTO Y ESTILO EN CADA CORTE"
                FontSize="10"
                CharacterSpacing="1.5"
                TextColor="#777777"
                HorizontalTextAlignment="Center"
                Margin="0,8,0,0"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>