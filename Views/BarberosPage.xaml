<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ReservasBarberia.Models"
             xmlns:converters="clr-namespace:ReservasBarberia.Converters"
             x:Class="ReservasBarberia.Views.BarberosPage"
             Title="Barberos"
             BackgroundColor="#F7F2EB">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InicialConverter
                x:Key="InicialConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout
            Padding="24,30,24,25"
            Spacing="20">

            
            <Label
                Text="Nuevo barbero"
                FontFamily="Georgia"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#1C1B19"
                Margin="0,0,0,10"/>

            
            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Nombre "
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#1C1B19"/>

                <Border
                    BackgroundColor="White"
                    Stroke="#E6E0D6"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 20"
                    HeightRequest="62"
                    Padding="12,0">

                    <Entry
                        Text="{Binding Nombre}"
                        Placeholder="Ej: Junior Pérez"
                        PlaceholderColor="#888888"
                        TextColor="#1C1B19"
                        FontSize="17"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"/>
                </Border>

                <Label
                    Text="{Binding ErrorNombre}"
                    TextColor="#B43D35"
                    FontSize="14"
                    IsVisible="{Binding ErrorNombre, Converter={StaticResource TieneTexto}}"/>
            </VerticalStackLayout>

            
            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Especialidad"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#1C1B19"/>

                <Border
                    BackgroundColor="White"
                    Stroke="#E6E0D6"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 20"
                    HeightRequest="62"
                    Padding="12,0">

                    <Entry
                        Text="{Binding Especialidad}"
                        Placeholder="Ej: Fade y diseño"
                        PlaceholderColor="#888888"
                        TextColor="#1C1B19"
                        FontSize="17"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"/>
                </Border>

                <Label
                    Text="{Binding ErrorEspecialidad}"
                    TextColor="#B43D35"
                    FontSize="14"
                    IsVisible="{Binding ErrorEspecialidad, Converter={StaticResource TieneTexto}}"/>
            </VerticalStackLayout>

            
            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Teléfono "
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#1C1B19"/>

                <Border
                    BackgroundColor="White"
                    Stroke="#E6E0D6"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 20"
                    HeightRequest="62"
                    Padding="12,0">

                    <Entry
                        Text="{Binding Telefono}"
                        Placeholder="809-000-0000"
                        PlaceholderColor="#888888"
                        TextColor="#1C1B19"
                        FontSize="17"
                        Keyboard="Telephone"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"/>
                </Border>

                <Label
                    Text="{Binding ErrorTelefono}"
                    TextColor="#B43D35"
                    FontSize="14"
                    IsVisible="{Binding ErrorTelefono, Converter={StaticResource TieneTexto}}"/>
            </VerticalStackLayout>

            
            <Button
                Text="Guardar barbero"
                BackgroundColor="#C9A447"
                TextColor="#1C1B19"
                FontAttributes="Bold"
                FontSize="18"
                CornerRadius="20"
                HeightRequest="68"
                Margin="0,0,0,5"
                Command="{Binding GuardarCommand}"/>

            
            <Label
                Text="Barberos registrados"
                FontFamily="Georgia"
                FontSize="25"
                FontAttributes="Bold"
                TextColor="#1C1B19"
                Margin="0,15,0,0"/>

            
            <VerticalStackLayout
                Spacing="14"
                BindableLayout.ItemsSource="{Binding Barberos}">

                <BindableLayout.EmptyView>
                    <Label
                        Text="Todavía no hay barberos registrados."
                        TextColor="Gray"
                        HorizontalOptions="Center"/>
                </BindableLayout.EmptyView>

                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Barbero">

                        
                        <Border
                            Stroke="#E6E0D6"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 25"
                            BackgroundColor="White"
                            Padding="18">

                            <Grid
                                ColumnDefinitions="85,*"
                                ColumnSpacing="15">

                                
                                <Border
                                    Grid.Column="0"
                                    WidthRequest="70"
                                    HeightRequest="70"
                                    BackgroundColor="#1C1B19"
                                    Stroke="Transparent"
                                    StrokeShape="Ellipse"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding Nombre, Converter={StaticResource InicialConverter}}"
                                        FontFamily="Georgia"
                                        FontSize="27"
                                        FontAttributes="Bold"
                                        TextColor="#C9A447"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"/>
                                </Border>

                                
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="7"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding Nombre}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="#1C1B19"/>

                                    <Label
                                        Text="{Binding Especialidad}"
                                        FontSize="16"
                                        TextColor="#292929"/>

                                    <Label
                                        Text="{Binding Telefono}"
                                        FontSize="15"
                                        TextColor="#888888"/>

                                </VerticalStackLayout>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </BindableLayout.ItemTemplate>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
