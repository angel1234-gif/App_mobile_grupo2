<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ReservasBarberia.Models"
             x:Class="ReservasBarberia.Views.ServiciosPage"
             Title="Servicios"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label Text="Nuevo servicio" FontSize="22" FontAttributes="Bold" />

            <!-- Nombre -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Nombre del servicio *" FontAttributes="Bold" />
                <Entry Text="{Binding Nombre}" Placeholder="Ej: Corte clásico" />
                <Label
                    Text="{Binding ErrorNombre}"
                    TextColor="Red"
                    FontSize="13"
                    IsVisible="{Binding ErrorNombre, Converter={StaticResource TieneTexto}}" />
            </VerticalStackLayout>

            <!-- Precio -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Precio (RD$) *" FontAttributes="Bold" />
                <Entry Text="{Binding Precio}" Placeholder="Ej: 300" Keyboard="Numeric" />
                <Label
                    Text="{Binding ErrorPrecio}"
                    TextColor="Red"
                    FontSize="13"
                    IsVisible="{Binding ErrorPrecio, Converter={StaticResource TieneTexto}}" />
            </VerticalStackLayout>

            <!-- Duración -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Duración en minutos *" FontAttributes="Bold" />
                <Entry Text="{Binding Duracion}" Placeholder="Ej: 30" Keyboard="Numeric" />
                <Label
                    Text="{Binding ErrorDuracion}"
                    TextColor="Red"
                    FontSize="13"
                    IsVisible="{Binding ErrorDuracion, Converter={StaticResource TieneTexto}}" />
            </VerticalStackLayout>

            <Button
                Text="Guardar servicio"
                BackgroundColor="#2C3E50"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="50"
                Margin="0,10,0,0"
                Command="{Binding GuardarCommand}" />

            <Label
                Text="Servicios registrados"
                FontSize="22"
                FontAttributes="Bold"
                Margin="0,20,0,0" />

            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Servicios}">

                <BindableLayout.EmptyView>
                    <Label Text="Todavía no hay servicios registrados." TextColor="Gray" />
                </BindableLayout.EmptyView>

                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Servicio">
                        <Border
                            Stroke="#DDDDDD"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="White"
                            Padding="15">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding Precio, StringFormat='Precio: RD${0:N2}'}" />
                                <Label Text="{Binding DuracionMinutos, StringFormat='Duración: {0} min'}" TextColor="Gray" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>