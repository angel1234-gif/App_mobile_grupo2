<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ReservasBarberia.Models"
             x:Class="ReservasBarberia.Views.ServiciosPage"
             Title="Servicios"
             BackgroundColor="#F7F2EB">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,30,24,25"
            Spacing="20">

            
            <Label
                Text="Nuevo servicio"
                FontFamily="Georgia"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#1C1B19"
                Margin="0,0,0,10"/>

            
            <VerticalStackLayout Spacing="6">

                <Label
                    Text="Nombre del servicio "
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#1C1B19"/>

                <Border
                    BackgroundColor="White"
                    Stroke="#E6E0D6"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 20"
                    HeightRequest="62"
                    Padding="12,0">

                    <Entry
                        Text="{Binding Nombre}"
                        Placeholder="Ej: Corte clásico"
                        PlaceholderColor="#888888"
                        TextColor="#1C1B19"
                        FontSize="17"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"/>
                </Border>

                <Label
                    Text="{Binding ErrorNombre}"
                    TextColor="#B43D35"
                    FontSize="14"
                    IsVisible="{Binding ErrorNombre, Converter={StaticResource TieneTexto}}"/>

            </VerticalStackLayout>

            
            <VerticalStackLayout Spacing="6">

                <Label
                    Text="Precio (RD$) "
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#1C1B19"/>

                <Border
                    BackgroundColor="White"
                    Stroke="#E6E0D6"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 20"
                    HeightRequest="62"
                    Padding="12,0">

                    <Entry
                        Text="{Binding Precio}"
                        Placeholder="Ej: 300"
                        PlaceholderColor="#888888"
                        TextColor="#1C1B19"
                        FontSize="17"
                        Keyboard="Numeric"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"/>
                </Border>

                <Label
                    Text="{Binding ErrorPrecio}"
                    TextColor="#B43D35"
                    FontSize="14"
                    IsVisible="{Binding ErrorPrecio, Converter={StaticResource TieneTexto}}"/>

            </VerticalStackLayout>

            
            <VerticalStackLayout Spacing="6">

                <Label
                    Text="Duración en minutos "
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#1C1B19"/>

                <Border
                    BackgroundColor="White"
                    Stroke="#E6E0D6"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 20"
                    HeightRequest="62"
                    Padding="12,0">

                    <Entry
                        Text="{Binding Duracion}"
                        Placeholder="Ej: 30"
                        PlaceholderColor="#888888"
                        TextColor="#1C1B19"
                        FontSize="17"
                        Keyboard="Numeric"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"/>
                </Border>

                <Label
                    Text="{Binding ErrorDuracion}"
                    TextColor="#B43D35"
                    FontSize="14"
                    IsVisible="{Binding ErrorDuracion, Converter={StaticResource TieneTexto}}"/>

            </VerticalStackLayout>

            
            <Button
                Text="Guardar servicio"
                BackgroundColor="#C9A447"
                TextColor="#1C1B19"
                FontAttributes="Bold"
                FontSize="18"
                CornerRadius="20"
                HeightRequest="68"
                Margin="0,0,0,5"
                Command="{Binding GuardarCommand}"/>

            
            <Label
                Text="Servicios registrados"
                FontFamily="Georgia"
                FontSize="25"
                FontAttributes="Bold"
                TextColor="#1C1B19"
                Margin="0,15,0,0"/>

            
            <VerticalStackLayout
                Spacing="14"
                BindableLayout.ItemsSource="{Binding Servicios}">

                <BindableLayout.EmptyView>
                    <Label
                        Text="Todavía no hay servicios registrados."
                        TextColor="#888078"
                        HorizontalOptions="Center"
                        Margin="0,15"/>
                </BindableLayout.EmptyView>

                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Servicio">

                        <Border
                            Stroke="#E6E0D6"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 25"
                            BackgroundColor="White"
                            Padding="18">

                            <VerticalStackLayout Spacing="12">

                                
                                <Label
                                    Text="{Binding Nombre}"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="#1C1B19"/>

                                
                                <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="12">

                                    
                                    <VerticalStackLayout
                                        Grid.Column="0"
                                        Spacing="4">

                                        <Label
                                            Text="PRECIO"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            TextColor="#A18A57"/>

                                        <Label
                                            Text="{Binding Precio, StringFormat='RD$ {0:N2}'}"
                                            FontSize="17"
                                            FontAttributes="Bold"
                                            TextColor="#1C1B19"/>

                                    </VerticalStackLayout>

                                    
                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="4">

                                        <Label
                                            Text="DURACIÓN"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            TextColor="#A18A57"/>

                                        <Label
                                            Text="{Binding DuracionMinutos, StringFormat='{0} minutos'}"
                                            FontSize="17"
                                            FontAttributes="Bold"
                                            TextColor="#1C1B19"/>

                                    </VerticalStackLayout>

                                </Grid>

                                
                                <Border
                                    BackgroundColor="#F2E8D0"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="12,7"
                                    HorizontalOptions="Start">

                                    <Label
                                        Text="Servicio disponible"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="#806329"/>

                                </Border>

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </BindableLayout.ItemTemplate>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
