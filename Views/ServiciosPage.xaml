<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ReservasBarberia.Models"
             x:Class="ReservasBarberia.Views.ServiciosPage"
             Title="Servicios"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Nuevo servicio" FontSize="22" FontAttributes="Bold" />

            <Label Text="Nombre del servicio *" FontAttributes="Bold" />
            <Entry x:Name="NombreEntry" Placeholder="Ej: Corte clásico" />

            <Label Text="Precio (RD$) *" FontAttributes="Bold" />
            <Entry x:Name="PrecioEntry" Placeholder="Ej: 300" Keyboard="Numeric" />

            <Label Text="Duración en minutos *" FontAttributes="Bold" />
            <Entry x:Name="DuracionEntry" Placeholder="Ej: 30" Keyboard="Numeric" />

            <Label
                x:Name="MensajeError"
                TextColor="Red"
                FontSize="14"
                IsVisible="False" />

            <Button
                Text="Guardar servicio"
                BackgroundColor="#2C3E50"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="50"
                Clicked="OnGuardarClicked" />

            <Label
                Text="Servicios registrados"
                FontSize="22"
                FontAttributes="Bold"
                Margin="0,20,0,0" />

            <VerticalStackLayout x:Name="ListaServicios" Spacing="10">

                <BindableLayout.EmptyView>
                    <Label Text="Todavía no hay servicios registrados." TextColor="Gray" />
                </BindableLayout.EmptyView>

                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Servicio">
                        <Border
                            Stroke="#DDDDDD"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="White"
                            Padding="15">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding Precio, StringFormat='Precio: RD${0:N2}'}" />
                                <Label Text="{Binding DuracionMinutos, StringFormat='Duración: {0} min'}" TextColor="Gray" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>