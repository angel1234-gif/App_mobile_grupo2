<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ReservasBarberia.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ReservasBarberia"
    xmlns:views="clr-namespace:ReservasBarberia.Views"
    Title="ReservasBarberia">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage"
        FlyoutItemIsVisible="False" />

    <ShellContent
        Title="Principal"
        ContentTemplate="{DataTemplate views:PrincipalPage}"
        Route="PrincipalPage" />

    <ShellContent
        Title="Reservas"
        ContentTemplate="{DataTemplate views:ListadoReservasPage}"
        Route="ListadoReservasPage" />

    <ShellContent
        Title="Nueva Reserva"
        ContentTemplate="{DataTemplate views:FormularioReservaPage}"
        Route="FormularioReservaPage" />
    <ShellContent
        Title="Barberos"
        ContentTemplate="{DataTemplate views:BarberosPage}"
        Route="BarberosPage" />
    <ShellContent
        Title="Servicios"
        ContentTemplate="{DataTemplate views:ServiciosPage}"
        Route="ServiciosPage" />

    <MenuItem Text="Cerrar sesión" Clicked="OnCerrarSesionClicked" />

</Shell>